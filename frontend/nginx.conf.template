# nginx 공식 이미지가 시작 시 envsubst로 ${...}를 치환한다.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types application/javascript text/css application/json application/geo+json image/svg+xml model/gltf+json;
    gzip_min_length 1024;

    # Vite 해시 파일명·Cesium 정적 자산은 장기 캐시
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location /cesiumStatic/ {
        add_header Cache-Control "public, max-age=604800";
    }

    # Host를 유지해야 백엔드가 동일 출처 요청으로 판단한다(CORS 불필요).
    location /api/ {
        proxy_pass http://${TWIN_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        client_max_body_size 100m;
        # SSE(센서·Job 진행률) 스트림은 버퍼링하지 않는다.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location /agent/ {
        proxy_pass http://${AGENT_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    # SPA 라우팅
    location / {
        try_files $uri $uri/ /index.html;
    }
}
