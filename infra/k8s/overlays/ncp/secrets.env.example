# kubectl -n twinpilot create secret generic twinpilot-secrets --from-env-file=secrets.env
# 이 파일을 secrets.env로 복사해 값을 채운다(secrets.env는 버전 관리에서 제외).
# 생성 예: openssl rand -hex 24  (DB 비밀번호는 접속 URL에 그대로 들어가므로 영숫자만 쓴다)

# PostgreSQL: twinpilot(앱·슈퍼유저), keycloak, agent(대화 체크포인트) 사용자
DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
AGENT_DB_PASSWORD=
# Keycloak 최초 관리자(admin) 비밀번호. 첫 로그인 후 관리 콘솔에서 개인 관리자 계정을 만들고 이 계정은 비활성화한다.
KEYCLOAK_ADMIN_PASSWORD=
# 서비스 계정 클라이언트 시크릿(realm 가져오기 때 Keycloak에 등록되고, 각 서비스가 토큰 교환에 쓴다)
AGENT_CLIENT_SECRET=
MCP_CLIENT_SECRET=
SENSOR_GATEWAY_SECRET=
# NCP Object Storage API 인증키(3D 모델 저장·DB 백업)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 비우면 AI 코파일럿이 규칙 기반 플래너로 동작한다.
ANTHROPIC_API_KEY=
