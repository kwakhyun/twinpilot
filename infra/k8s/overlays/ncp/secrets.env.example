# kubectl -n twinpilot create secret generic twinpilot-secrets --from-env-file=secrets.env
# 이 파일을 secrets.env로 복사해 값을 채운다(secrets.env는 버전 관리에서 제외).
DB_PASSWORD=change-me
# NCP Object Storage(API 인증키)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 비우면 AI 코파일럿이 규칙 기반 플래너로 동작한다.
ANTHROPIC_API_KEY=
# 대화 상태 공유(ai-agent 다중 레플리카)
CHECKPOINT_DB_URL=postgresql://twin:change-me@postgis:5432/twinpilot
