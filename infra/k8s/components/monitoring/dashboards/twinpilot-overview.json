{
  "uid": "twinpilot-overview",
  "title": "TwinPilot 운영 개요",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "API 요청/초",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"twin-api\"}[5m]))"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "API 5xx 비율",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"twin-api\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"twin-api\"}[5m])),1e-9)"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Job 대기열",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(twinpilot_jobs_queued)"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "센서 SSE 구독",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(twinpilot_sse_subscribers{stream=\"sensors\"})"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "API p95 지연(경로별)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"twin-api\",uri!~\".*stream|.*events\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Job 처리 시간 p95(유형별)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, type) (rate(twinpilot_jobs_duration_seconds_bucket[15m])))",
          "legendFormat": "{{type}}"
        },
        {
          "refId": "B",
          "expr": "sum by (type, status) (increase(twinpilot_jobs_completed_total[15m]))",
          "legendFormat": "{{type}} {{status}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "에이전트 대화(결과별)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode, outcome) (rate(twinpilot_agent_chat_total[5m]))",
          "legendFormat": "{{mode}} {{outcome}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "LLM 토큰/분",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(twinpilot_agent_llm_tokens_total[5m])) * 60",
          "legendFormat": "{{kind}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "MCP 도구 호출(결과별)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, outcome) (rate(twinpilot_mcp_tool_calls_total[5m]))",
          "legendFormat": "{{tool}} {{outcome}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "MCP 도구 p95",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(twinpilot_mcp_tool_seconds_bucket[5m])))",
          "legendFormat": "{{tool}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "센서 수집",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(twinpilot_sensors_readings_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "DB 커넥션",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hikaricp_connections_active{job=\"twin-api\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "max(hikaricp_connections_pending{job=\"twin-api\"})",
          "legendFormat": "pending"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "JVM 힙",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"twin-api\",area=\"heap\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "LLM 대체 응답",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(twinpilot_agent_llm_fallback_total[15m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "id": 14
    }
  ],
  "tags": [
    "twinpilot"
  ]
}