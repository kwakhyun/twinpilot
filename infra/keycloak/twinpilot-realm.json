{
  "realm": "twinpilot",
  "displayName": "TwinPilot",
  "enabled": true,
  "sslRequired": "${KC_SSL_REQUIRED:external}",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ko",
    "en"
  ],
  "defaultLocale": "ko",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "CODE_TO_TOKEN_ERROR",
    "TOKEN_EXCHANGE",
    "TOKEN_EXCHANGE_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "VIEWER",
        "description": "지도·건물·통계·센서 조회, 커버리지·출동 분석, 코파일럿"
      },
      {
        "name": "ANALYST",
        "description": "최적입지 추천 등 분석 Job",
        "composite": true,
        "composites": {
          "realm": [
            "VIEWER"
          ]
        }
      },
      {
        "name": "PLANNER",
        "description": "계획 시설 배치, 3D 모델 관리",
        "composite": true,
        "composites": {
          "realm": [
            "ANALYST"
          ]
        }
      },
      {
        "name": "ADMIN",
        "description": "데이터 적재, 위험도 재계산, 감사 로그",
        "composite": true,
        "composites": {
          "realm": [
            "PLANNER"
          ]
        }
      },
      {
        "name": "INGEST",
        "description": "센서 측정값 수집(서비스 계정)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "twinpilot-web",
      "name": "TwinPilot 웹",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "${TWINPILOT_WEB_URL:http://localhost:8088}/*",
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${TWINPILOT_WEB_URL:http://localhost:8088}/*##http://localhost:5173/*##http://localhost:4173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-twinpilot-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "twinpilot-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-twinpilot-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "twinpilot-agent",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "twinpilot-api",
      "name": "TwinPilot API(리소스 서버)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "twinpilot-agent",
      "name": "AI 에이전트",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AGENT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-twinpilot-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "twinpilot-mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "roles",
        "profile",
        "basic"
      ]
    },
    {
      "clientId": "twinpilot-mcp",
      "name": "MCP 서버",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MCP_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-twinpilot-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "twinpilot-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "roles",
        "profile",
        "basic"
      ]
    },
    {
      "clientId": "twinpilot-sensor-gateway",
      "name": "IoT 센서 게이트웨이",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SENSOR_GATEWAY_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-twinpilot-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "twinpilot-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "roles",
        "basic"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-twinpilot-mcp",
      "enabled": true,
      "serviceAccountClientId": "twinpilot-mcp",
      "realmRoles": [
        "ANALYST"
      ]
    },
    {
      "username": "service-account-twinpilot-sensor-gateway",
      "enabled": true,
      "serviceAccountClientId": "twinpilot-sensor-gateway",
      "realmRoles": [
        "INGEST"
      ]
    }
  ]
}